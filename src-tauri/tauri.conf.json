{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevResidue",
  "version": "0.1.0",
  "identifier": "com.devresidue.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "DevResidue — Developer Storage Manager",
        "width": 1200,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
